#!/bin/sh /etc/rc.common

START=95
STOP=15
USE_PROCD=1

fail() {
	logger -t hongguo "$*"
	echo "hongguo: $*" >&2
	return 1
}

start_service() {
	local enabled listen port password cache_dir cache_mb max_media_mb prepare_concurrency
	config_load hongguo
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get listen main listen '0.0.0.0'
	config_get port main port 8797
	config_get password main password
	config_get cache_dir main cache_dir '/tmp/hongguo-media'
	config_get cache_mb main cache_mb 64
	config_get max_media_mb main max_media_mb 32
	config_get prepare_concurrency main prepare_concurrency 1
	[ "${#password}" -ge 12 ] && [ "${#password}" -le 128 ] || { fail '请先设置 12 至 128 字节的观看密码'; return 1; }
	case "$password" in *'
'*) fail '密码不能包含换行'; return 1;; esac
	case "$port:$cache_mb:$max_media_mb:$prepare_concurrency" in *[!0-9:]*|'') fail '端口和大小必须是整数'; return 1;; esac
	[ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || { fail '端口必须为 1024 至 65535'; return 1; }
	[ "$cache_mb" -ge 16 ] && [ "$cache_mb" -le 4096 ] || { fail '缓存阈值必须为 16 至 4096 MiB'; return 1; }
	[ "$max_media_mb" -ge 8 ] && [ "$max_media_mb" -le "$cache_mb" ] || { fail '单文件上限必须为 8 MiB 至缓存阈值'; return 1; }
	[ "$prepare_concurrency" -ge 1 ] && [ "$prepare_concurrency" -le 4 ] || { fail '准备并发必须为 1 至 4'; return 1; }
	case "$cache_dir" in /tmp/hongguo-*|/mnt/*/hongguo-*) ;; *) fail '缓存目录请用 /tmp/hongguo-* 或 /mnt/挂载点/hongguo-* 专用目录'; return 1;; esac
	case "$cache_dir" in *'/../'*|*'/..'|*'/./'*|*'/.'|*'//'*) fail '缓存路径不可包含 ..、. 或重复斜线'; return 1;; esac
	[ ! -L "$cache_dir" ] || { fail '缓存目录不能是符号链接'; return 1; }
	# Refuse unmounted /mnt destinations instead of writing into the root disk.
	case "$cache_dir" in /mnt/*)
		awk -v p="$cache_dir" '($2 ~ /^\/mnt\// && index(p, $2 "/") == 1) { found=1 } END { exit !found }' /proc/mounts || { fail '缓存目录所在的数据盘尚未挂载'; return 1; }
	;; esac
	umask 077
	mkdir -p /var/run/hongguo /etc/hongguo "$cache_dir" || return 1
	chown hongguo:hongguo /var/run/hongguo /etc/hongguo "$cache_dir" || return 1
	chmod 700 /var/run/hongguo /etc/hongguo "$cache_dir"
	chmod 600 /etc/config/hongguo
	printf '%s' "$password" > /var/run/hongguo/password
	chown hongguo:hongguo /var/run/hongguo/password
	chmod 600 /var/run/hongguo/password

	procd_open_instance main
	procd_set_param command /usr/bin/hongguo-server --lan --listen "$listen" --port "$port" --password-file /var/run/hongguo/password --data-dir /etc/hongguo --cache-mb "$cache_mb" --max-media-mb "$max_media_mb" --prepare-concurrency "$prepare_concurrency"
	procd_set_param user hongguo
	procd_set_param group hongguo
	procd_set_param env MINIREEL_CACHE_DIR="$cache_dir" GOMEMLIMIT=192MiB GOGC=75
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/hongguo
	procd_set_param limits nofile='1024 1024'
	procd_close_instance
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger hongguo
}
